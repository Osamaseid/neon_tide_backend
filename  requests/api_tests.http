### 7. INVALID DATE FORMAT — should fail schema validation
POST http://127.0.0.1:8000/check-availability
Content-Type: application/json

{
  "group_size": 1,
  "participant_weights": [180],
  "booking_date": "15-03-2026"
}

> {%
  client.test("Status 422 bad date", function() {
    client.assert(response.status === 422, "Expected 422 for invalid date format");
  });
%}

###

### 8. NEGATIVE WEIGHT — should fail schema validation
POST http://127.0.0.1:8000/check-availability
Content-Type: application/json

{
  "group_size": 1,
  "participant_weights": [-50],
  "booking_date": "2026-03-10"
}

> {%
  client.test("Status 422 negative weight", function() {
    client.assert(response.status === 422, "Expected 422 for negative weight");
  });
%}

###

### 9. TANDEM ALLOCATION — 6 participants forces tandem usage
POST http://127.0.0.1:8000/check-availability
Content-Type: application/json

{
  "group_size": 6,
  "participant_weights": [200, 200, 200, 200, 200, 200],
  "booking_date": "2026-03-10"
}

> {%
  client.test("Status 200", function() {
    client.assert(response.status === 200, "Expected 200");
  });
  client.test("Tandem kayak used", function() {
    const allocations = response.body.fleet.allocations;
    const hasTandem = allocations.some(a => a.vessel === "tandem_kayak");
    client.assert(hasTandem, "Expected tandem_kayak in allocations");
  });
%}

###
