### 1. VALID BOOKING — Standard pricing (non-lunar window)
POST http://127.0.0.1:8000/check-availability
Content-Type: application/json

{
  "group_size": 3,
  "participant_weights": [180, 200, 190],
  "booking_date": "2026-03-10"
}

> {%
  client.test("Status 200", function() {
    client.assert(response.status === 200, "Expected 200");
  });
  client.test("Status is available", function() {
    client.assert(response.body.status === "available", "Expected available");
  });
  client.test("Pricing label present", function() {
    client.assert(response.body.pricing.pricing_label !== undefined, "Missing pricing_label");
  });
%}

###

### 2. NEW MOON PREMIUM — booking_date near a new moon (2026-02-17 is a new moon)
POST http://127.0.0.1:8000/check-availability
Content-Type: application/json

{
  "group_size": 2,
  "participant_weights": [160, 175],
  "booking_date": "2026-02-17"
}

> {%
  client.test("Status 200", function() {
    client.assert(response.status === 200, "Expected 200");
  });
  client.test("New Moon Premium applied", function() {
    client.assert(
      response.body.pricing.pricing_label.includes("New Moon"),
      "Expected New Moon Premium label"
    );
  });
  client.test("Price is 125", function() {
    client.assert(response.body.pricing.final_price === 125.0, "Expected $125");
  });
%}

###

### 3. FULL MOON DISCOUNT — booking_date near a full moon (2026-03-03 is a full moon)
POST http://127.0.0.1:8000/check-availability
Content-Type: application/json

{
  "group_size": 1,
  "participant_weights": [200],
  "booking_date": "2026-03-03"
}

> {%
  client.test("Status 200", function() {
    client.assert(response.status === 200, "Expected 200");
  });
  client.test("Full Moon Discount applied", function() {
    client.assert(
      response.body.pricing.pricing_label.includes("Full Moon"),
      "Expected Full Moon Discount label"
    );
  });
  client.test("Price is 85", function() {
    client.assert(response.body.pricing.final_price === 85.0, "Expected $85");
  });
%}

