### 4. GROUP SIZE MISMATCH — group_size does not match weights array length
POST http://127.0.0.1:8000/check-availability
Content-Type: application/json

{
  "group_size": 2,
  "participant_weights": [180, 200, 190],
  "booking_date": "2026-03-10"
}

> {%
  client.test("Status 422", function() {
    client.assert(response.status === 422, "Expected 422 for mismatch");
  });
%}

###

### 5. OVERWEIGHT PARTICIPANT — exceeds all vessel limits
POST http://127.0.0.1:8000/check-availability
Content-Type: application/json

{
  "group_size": 1,
  "participant_weights": [600],
  "booking_date": "2026-03-10"
}

> {%
  client.test("Status 400 fleet exceeded", function() {
    client.assert(response.status === 400, "Expected 400 for fleet capacity exceeded");
  });
%}

###

### 6. FLEET CAPACITY EXCEEDED — too many participants for entire fleet
POST http://127.0.0.1:8000/check-availability
Content-Type: application/json

{
  "group_size": 14,
  "participant_weights": [150, 150, 150, 150, 150, 150, 150, 150, 150, 150, 150, 150, 150, 150],
  "booking_date": "2026-03-10"
}

> {%
  client.test("Status 400 over capacity", function() {
    client.assert(response.status === 400, "Expected 400 for over capacity");
  });
%}

